# Copy to .env and fill in. Never commit .env or anything in secrets/.

# --- Network (testnet only) ---
GRPC_HOST=grpc.testnet.concordium.com
GRPC_PORT=20000
GENESIS_HASH=4221332d34e1694168c2a0c0b3fd0f273809612cb13d000d5c2e00e85f50f796
WALLET_PROXY=https://wallet-proxy.testnet.concordium.com
# Hosted Agent Registry REST/MCP. It defaults to mainnet, so the code always adds network=testnet.
BADGE_API=https://agent-registry-mcp.concordium.com
REGISTRY_INDEX=12802
REGISTRY_SUBINDEX=0

# --- Bounty board contract (filled in by scripts/deploy.ts) ---
CONTRACT_INDEX=
CONTRACT_SUBINDEX=0

# --- Reward token (PLT). EUDemo comes from the testnet stablecoin faucet and has an allow list. ---
REWARD_TOKEN_ID=EUDemo
# Where to send people whose account is not on the EUDemo allow list.
FAUCET_URL=

# --- Keys (wallet exports from Concordium Wallet for Web; see docs/setup-accounts.md) ---
# Pays every sponsored fee. Holds CCD only.
SPONSOR_KEY_FILE=secrets/sponsor.export
# Operator = escrow account: holds escrowed EUDemo and calls operator-only entrypoints.
OPERATOR_KEY_FILE=secrets/operator.export
# Raw ed25519 key (hex) the board uses to attest identity and badge checks. Generated by scripts/deploy.ts.
ATTESTOR_KEY_FILE=secrets/attestor.key
# Warn when the sponsor's CCD balance drops below this.
SPONSOR_MIN_CCD=100

# --- Server ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DB_PATH=data/board.db
# Contract windows used at deploy time (ms). 3 days each by default; the demo instance uses minutes.
REVIEW_WINDOW_MS=259200000
PAYMENT_WINDOW_MS=259200000

# --- Reference agent ---
AGENT_KEY_FILE=secrets/worker-agent.export
BOARD_MCP_URL=http://localhost:8787/mcp
# Badge (CIS-2 token address) of the registered agent, printed by agent/src/register.ts.
AGENT_BADGE=

# --- Demo scripts ---
POSTER_KEY_FILE=secrets/poster.export
WORKER_HUMAN_KEY_FILE=secrets/worker-human.export
